{
  "name": "poker-results-tracker-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test:e2e": "start-server-and-test 'npm run dev' http://localhost:3001 'cypress open --e2e'",
    "test:e2e:login": "start-server-and-test 'npm run dev' http://localhost:3001 'cypress run --spec \"cypress/e2e/login.cy.ts\"'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:component": "cypress run --component",
    "playwright": "playwright test",
    "playwright:ui": "playwright test --ui",
    "playwright:report": "playwright show-report",
    "playwright:debug": "playwright test --debug"
  },
  "dependencies": {
    "@faker-js/faker": "^9.4.0",
    "@mdi/font": "^7.4.47",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "currency.js": "^2.0.4",
    "dotenv": "^16.4.7",
    "pinia": "^3.0.0",
    "qrcode.vue": "^3.6.0",
    "vue": "^3.5.12",
    "vue-router": "^5.0.0",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@cypress/vite-dev-server": "^7.3.3",
    "@cypress/vue": "^6.0.2",
    "@playwright/test": "^1.52.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.1.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "cypress": "^15.0.0",
    "cypress-vite": "^1.10.1",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^28.0.0",
    "npm-run-all2": "^8.0.0",
    "prettier": "^3.3.3",
    "start-server-and-test": "^3.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.3.5"
  }
}